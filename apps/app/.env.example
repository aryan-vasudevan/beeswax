# Copy to apps/app/.env and fill in. Expo reads env files from the app
# directory, not the repo root.
#
# For local development run `supabase status` and use the API URL and the
# anon (publishable) key it prints -- the local keys are fixed and not
# secret. Point at the dev project, never prod, during development.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
